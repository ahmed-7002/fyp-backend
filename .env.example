# PostgreSQL connection string (Neon serverless example)
# Get this from your Neon project dashboard -> Connection Details
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<neon-host>/<dbname>?sslmode=require

# Clerk (get from https://dashboard.clerk.com -> API Keys)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_JWKS_URL=https://<your-clerk-subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-subdomain>.clerk.accounts.dev

# CORS - the URL your Vite frontend runs on
FRONTEND_ORIGIN=http://localhost:5173

# Path to the trained FER-2013 model weights (.h5 or .keras)
FER_MODEL_PATH=./app/ml_models/fer2013_model.h5

# App
ENV=development
